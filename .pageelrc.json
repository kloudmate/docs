{
  "version": 2,
  "settings": {
    "projectType": "github",
    "domainUrl": "https://docs.kloudmate.com",
    "postFileTypes": ".md",
    "imageFileTypes": "image/*",
    "publishDateSource": "file",
    "imageCompressionEnabled": true,
    "maxImageSize": 500,
    "imageResizeMaxWidth": 1200
  },
  "commitMessages": {
    "newPost": "feat(content): add \"{filename}\"",
    "updatePost": "fix(content): update \"{filename}\"",
    "newImage": "feat(assets): add image \"{filename}\"",
    "updateImage": "refactor(assets): update image \"{filename}\""
  },
  "collections": [
    {
      "id": "collection-docs-main",
      "name": "Docs",
      "postsPath": "src/content/docs",
      "imagesPath": "public/images"
    },
    {
      "id": "collection-engineering-digests",
      "name": "Engineering Digests",
      "postsPath": "content/engineering-digests/2026",
      "imagesPath": "public/images"
    }
  ]
}
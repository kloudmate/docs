---
import config from 'virtual:starlight/user-config';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
/**
 * Normalize route comparisons so top-level tabs stay active with or without trailing slashes.
 */
function normalizePath(pathname) {
	if (pathname.length > 1 && pathname.endsWith('/')) {
		return pathname.slice(0, -1);
	}

	return pathname;
}

const currentPath = normalizePath(Astro.url.pathname);
const tabs = [
	{ label: 'Docs', href: '/docs/getting-started/overview/', match: '/docs' },
	{ label: 'Guides', href: '/guides/', match: '/guides' },
	{ label: 'API', href: '/api/', match: '/api' },
];
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>

	<div class="desktop-actions sl-hidden md:sl-flex print:hidden">
		<div class="desktop-search">
			{shouldRenderSearch && <Search />}
		</div>

		<nav class="header-tabs" aria-label="Documentation sections">
			{
				tabs.map((tab) => {
					const isActive =
						currentPath === tab.match ||
						currentPath.startsWith(`${tab.match}/`) ||
						(currentPath === '/' && tab.match === '/docs');

					return (
						<a
							href={tab.href}
							class:list={['header-tab', { active: isActive }]}
							aria-current={isActive ? 'page' : undefined}
						>
							{tab.label}
						</a>
					);
				})
			}
		</nav>

		<div class="right-group">
			<ThemeSelect />
		</div>
	</div>

	<div class="mobile-search md:sl-hidden print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			align-items: center;
			gap: var(--sl-nav-gap);
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.desktop-actions,
		.desktop-search,
		.header-tabs,
		.mobile-search,
		.right-group {
			display: flex;
			align-items: center;
		}

		.desktop-actions {
			flex: 1 1 auto;
			margin-inline-start: auto;
			justify-content: flex-end;
			gap: 1.5rem;
			min-width: 0;
		}

		.desktop-search {
			flex: 0 0 auto;
			width: clamp(18rem, 24vw, 22rem);
			min-width: 18rem;
		}

		.mobile-search {
			margin-inline-start: auto;
		}

		.header-tabs {
			flex: 0 0 auto;
			gap: 2.25rem;
			white-space: nowrap;
		}

		.header-tab {
			display: flex;
			align-items: center;
			color: var(--sl-color-gray-3);
			font-size: 1.05rem;
			font-weight: 500;
			text-decoration: none;
			transition: color 0.2s;
		}

		.header-tab:hover {
			color: var(--sl-color-gray-1);
		}

		.header-tab.active {
			color: var(--sl-color-gray-1);
			font-weight: 600;
		}

		@media (min-width: 50rem) {
			.title-wrapper {
				flex: 0 0 auto;
			}

			.right-group {
				flex: 0 0 auto;
				gap: 0.75rem;
				justify-self: end;
			}

			.right-group::before {
				content: '';
				width: 1px;
				height: 1.5rem;
				background: var(--sl-color-hairline-shade);
				margin-inline-end: 0.25rem;
			}
		}
	}
</style>

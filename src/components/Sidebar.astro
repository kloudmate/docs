---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

/**
 * Keep route matching stable across both `/foo` and `/foo/` paths.
 */
function normalizePath(pathname) {
	if (pathname.length > 1 && pathname.endsWith('/')) {
		return pathname.slice(0, -1);
	}

	return pathname;
}

/**
 * Sidebar section switching should be based on the docs route, not the deploy base prefix.
 */
function stripBasePath(pathname) {
	const normalizedBasePath = normalizeBasePath(import.meta.env.BASE_URL);

	if (normalizedBasePath === '/') {
		return pathname;
	}

	if (pathname === normalizedBasePath.slice(0, -1)) {
		return '/';
	}

	return pathname.startsWith(normalizedBasePath)
		? pathname.slice(normalizedBasePath.length - 1)
		: pathname;
}

function normalizeBasePath(pathname) {
	if (!pathname || pathname === '/') {
		return '/';
	}

	return `/${pathname.replace(/^\/+|\/+$/g, '')}/`;
}

const currentPath = normalizePath(stripBasePath(Astro.url.pathname));
const activeGroupLabel = currentPath.startsWith('/guides')
	? 'Guides'
	: currentPath.startsWith('/api')
		? 'API Reference'
		: 'Platform Docs';
const currentSidebar = Astro.locals.starlightRoute.sidebar || [];
const sectionSidebar = currentSidebar.flatMap((entry) => {
	if (entry.type === 'group' && entry.label === activeGroupLabel) {
		return entry.entries;
	}

	return [];
});
---

<SidebarPersister>
	<div class="section-sidebar">
		<SidebarSublist sublist={sectionSidebar} />
	</div>
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	@layer brand-overrides {
		.section-sidebar :global([aria-current='page']),
		.section-sidebar :global([aria-current='page']:hover),
		.section-sidebar :global([aria-current='page']:focus) {
			background: transparent;
			color: #f45b26;
		}
	}
</style>

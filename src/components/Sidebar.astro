---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

/**
 * Keep route matching stable across both `/foo` and `/foo/` paths.
 */
function normalizePath(pathname) {
	if (pathname.length > 1 && pathname.endsWith('/')) {
		return pathname.slice(0, -1);
	}

	return pathname;
}

const currentPath = normalizePath(Astro.url.pathname);
const activeGroupLabel = currentPath.startsWith('/guides')
	? 'Guides'
	: currentPath.startsWith('/api')
		? 'API Reference'
		: 'Platform Docs';
const currentSidebar = Astro.locals.starlightRoute.sidebar || [];
const sectionSidebar = currentSidebar.flatMap((entry) => {
	if (entry.type === 'group' && entry.label === activeGroupLabel) {
		return entry.entries;
	}

	return [];
});
const mobileTabs = [
	{ label: 'Docs', href: '/docs/getting-started/overview/', match: '/docs' },
	{ label: 'Guides', href: '/guides/', match: '/guides' },
	{ label: 'API', href: '/api/', match: '/api' },
];
---

<div class="mobile-tabs md:sl-hidden">
	{
		mobileTabs.map((tab) => {
			const isActive =
				currentPath === tab.match ||
				currentPath.startsWith(`${tab.match}/`) ||
				(currentPath === '/' && tab.match === '/docs');

			return (
				<a
					href={tab.href}
					class:list={['mobile-tab', { active: isActive }]}
					aria-current={isActive ? 'page' : undefined}
				>
					{tab.label}
				</a>
			);
		})
	}
</div>

<SidebarPersister>
	<SidebarSublist sublist={sectionSidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	@layer starlight.core {
		.mobile-tabs {
			display: none;
		}

		.mobile-tab {
			padding: 0.35rem 0.9rem;
			border: 1px solid var(--sl-color-hairline-shade);
			border-radius: 999px;
			background-color: var(--sl-color-black);
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-sm);
			font-weight: 600;
			text-decoration: none;
		}

		.mobile-tab.active {
			border-color: var(--sl-color-accent);
			background-color: var(--sl-color-accent-low);
			color: var(--sl-color-accent-high);
		}

		@media (max-width: 50rem) {
			.mobile-tabs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1.5rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--sl-color-hairline);
			}
		}
	}
</style>
